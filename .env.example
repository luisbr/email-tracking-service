HOST=127.0.0.1
PORT=3010

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=email_tracking

EMAIL_TRACKING_BASE_URL=http://127.0.0.1:3010
EMAIL_TRACKING_ASSET_PATH=/image/060926-Mailing2_01.png
EMAIL_TRACKING_DEFAULT_CAMPAIGN=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret
ADMIN_TIME_ZONE=America/Mexico_City

# The platform keeps all new records within this account. If omitted, the first
# authenticated platform request creates the account named below.
PLATFORM_DEFAULT_ACCOUNT_ID=
PLATFORM_DEFAULT_ACCOUNT_NAME=LBR

# Encryption for SES credentials: generate with `openssl rand -base64 32`.
PLATFORM_ENCRYPTION_KEY=

# SES worker and client assets.
ASSET_S3_BUCKET=
ASSET_S3_REGION=
ASSET_S3_ACCESS_KEY=
ASSET_S3_SECRET_KEY=

# Optional AI template editor.
OPENAI_API_KEY=
OPENAI_TEMPLATE_MODEL=gpt-5
SEND_MAX_ATTEMPTS=3
